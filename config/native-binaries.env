# Pinned binary manifest for Embarsy MVP packaging.
# Scripts source this file first and allow environment variables to override values.

EMBARSY_API_VERSION=0.1.0

# Fill exact versions after QA on the target Mac.
# Example: QDRANT_VERSION=1.13.4
QDRANT_VERSION=1.18.2
OLLAMA_VERSION=0.30.11

# Optional local source paths for acquisition scripts.
EMBARSY_QDRANT_SOURCE_BIN=
EMBARSY_QDRANT_SOURCE_DIR=
EMBARSY_OLLAMA_SOURCE_BIN=

