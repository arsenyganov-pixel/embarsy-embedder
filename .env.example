# Copy to `.env` for local development. Embarsy.app will store generated values
# in Keychain/App Support during the native installation flow.
EMBARSY_HOST=127.0.0.1
EMBARSY_API_PORT=8000
EMBARSY_QDRANT_REST_PORT=6333
EMBARSY_QDRANT_GRPC_PORT=6334

# Generated by `scripts/setup.sh` for local development; never commit a real secret.
QDRANT_API_KEY=change-me-generate-with-setup

# Optional API key for Roo -> FastAPI wrapper.
# If empty, the wrapper accepts local requests without auth.
EMBARSY_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-embedding
OLLAMA_SOURCE_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
OLLAMA_KEEP_ALIVE=-1

# Native binary contracts. Relative paths are resolved from the repository root.
EMBARSY_QDRANT_BIN=bin/qdrant
EMBARSY_OLLAMA_BIN=bin/ollama
EMBARSY_API_BIN=bin/embarsy-api

# Optional local development override. If empty, scripts use macOS Application Support.
EMBARSY_APP_SUPPORT=

# Used by Embarsy.app action “Open project in VSCode”.
EMBARSY_DEFAULT_PROJECT=/path/to/your/default/project
