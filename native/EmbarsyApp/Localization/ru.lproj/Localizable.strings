"Verify health" = "Проверить состояние";
"Verifying Watcher-compatible authentication..." = "Проверка авторизации в режиме Watcher…";
"Version %@, changed %@, at %@." = "Версия %@, изменена %@, путь %@.";
"Version %@. Copies marked with the same letter have identical contents; different letters mean the copies differ." = "Версия %@. Копии с одной буквой совпадают по содержимому; разные буквы — копии различаются.";
"Version: %@" = "Версия: %@";
